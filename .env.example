# Copy to .env and fill in. .env is gitignored - never commit real keys.
# The weekly cloud routine reads the same three names from its own secret store.

# https://fred.stlouisfed.org/docs/api/api_key.html (free, instant)
FRED_API_KEY=

# https://resend.com -> API Keys (free tier: 100 emails/day)
RESEND_API_KEY=

# Where the report goes. Comma-separated addresses allowed.
REPORT_EMAIL_TO=you@example.com

# Optional. Must be a Resend-verified sender; defaults to Resend's onboarding address.
# REPORT_EMAIL_FROM=Froth Dashboard <dashboard@yourdomain.com>
